# Settings for "oracle2c8 serve" (web UI) and "oracle2c8 analyze".
#
# Copy this file to application.properties in the folder you start the migrator from:
#   cp application.properties.example application.properties
# application.properties is git-ignored, so credentials you put there are never committed.
#
# Any value can come from the environment: ${CAMUNDA_CLIENT_SECRET} or ${NAME:default}.
# An environment variable named after the key always wins, e.g.
#   CAMUNDA_WEBMODELER_CLIENT_SECRET overrides camunda.webmodeler.client-secret

# ------------------------------------------------------------------ web UI
# Keep 127.0.0.1 unless other machines must reach the UI (anyone who can reach it can upload files).
server.host=127.0.0.1
server.port=8080
# Upload limits per browser session
server.max-upload-mb=200
server.max-files=5000
# Idle sessions (uploaded files and results) are deleted after this many minutes
server.workspace-ttl-minutes=240

# ------------------------------------------------------------------ conversion defaults
# Folder with finished migrations (Oracle + Camunda 8 models) the converter learns from
migrator.knowledge-base-dir=knowledge-base
# Camunda version written into the models: 8.5.0, 8.6.0, 8.7.0, 8.8.0
migrator.platform-version=8.6.0
# camunda (Camunda user tasks) or job-worker (job-worker based user tasks)
migrator.user-tasks=camunda

# ------------------------------------------------------------------ Camunda Web Modeler (upload, no deploy)
# saas or self-managed
camunda.webmodeler.mode=saas

# API client credentials
#   SaaS:         Console > Organization > Administration API > Create new credentials,
#                 with Web Modeler API permissions Create, Read and Update.
#   Self-Managed: Identity > Applications > add an M2M application,
#                 with Web Modeler API permissions Create, Read and Update.
camunda.webmodeler.client-id=
camunda.webmodeler.client-secret=${CAMUNDA_WEBMODELER_SECRET:}

# Target project: an existing project id, or a project name (found or created)
camunda.webmodeler.project-id=
camunda.webmodeler.project-name=Oracle BPM migration

# Defaults per mode; change them only if your installation differs.
#   SaaS:
#     camunda.webmodeler.api-url=https://modeler.cloud.camunda.io
#     camunda.webmodeler.token-url=https://login.cloud.camunda.io/oauth/token
#     camunda.webmodeler.audience=api.cloud.camunda.io
#   Self-Managed (Keycloak defaults of the Camunda Helm chart / docker-compose):
#     camunda.webmodeler.api-url=http://localhost:8070
#     camunda.webmodeler.token-url=http://localhost:18080/auth/realms/camunda-platform/protocol/openid-connect/token
#     camunda.webmodeler.audience=web-modeler-api
# Some identity providers (e.g. Microsoft Entra ID) need a scope instead of an audience:
#     camunda.webmodeler.scope=api://<web-modeler-api-app-id>/.default
camunda.webmodeler.timeout-seconds=30

# ------------------------------------------------------------------ effort estimate (analyze)
# Hours per follow-up item; the estimate is a planning aid, not a quote.
analyze.hours.form=4
analyze.hours.job-worker=6
analyze.hours.inbound-trigger=6
analyze.hours.correlation=1
analyze.hours.undefined-task=2
analyze.hours.expression=1
analyze.hours.unsupported=4
analyze.hours.secret=0.5
analyze.hours.review=0.5
analyze.hours.failed-file=16
# Testing and deployment per converted process
analyze.hours.per-process=4
